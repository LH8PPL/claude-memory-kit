packages/cli/template/
context/.index/

*.tgz
.bench-logs/

# core-memory-kit:gitignore:start v0.6.2
# core-memory-kit — added by `cmk install`. Do not edit by hand;
# `cmk install` refreshes these lines idempotently. Remove via
# `cmk uninstall`.

# Local-tier (per-machine, never committed)
context.local/

# SQLite + FTS5 read cache (regenerable from markdown)
context/.index/

# Run-time locks + transient state
context/.locks/

# Diagnostic NDJSON logs (observability only; carry raw turn excerpts —
# e.g. discarded-low-trust traces — that are NOT secret-screened, so they
# must never be committed). The durable memory lives in the scratchpads +
# fact files, not these logs.
context/sessions/*.extract.log

# Per-day distilled artifacts: daily-distill writes today-<date>.distilled.md
# per day so a killed run resumes from the days it finished. They are TRANSIENT
# working state — the durable rolling summary is recent.md (assembled from them).
# Gitignored so intermediate summary output doesn't travel with `git clone`;
# losing them only forces a re-distill.
context/sessions/today-*.distilled.md

# Transcript-extraction temp buffer. capture-turn writes
# context/transcripts/.extract-<ts>.tmp as the turn buffer for the detached
# auto-extract child, which consumes + deletes it. Gitignored so a crash-orphaned
# partial (raw, un-screened turn content) never travels with `git clone`.
context/transcripts/.extract-*.tmp

# Transcript live buffer (privacy screen). Hooks append each turn here first;
# entries move to the committed transcript only AFTER the async privacy judge
# screens them. Un-judged content must never travel with `git clone`.
context/transcripts/*.live.md

# Raw session extracts from `cmk import-sessions` — raw, UN-screened
# conversation text (the deep-recall floor for imported history), so it stays
# machine-local like the live buffer; only the screened per-session summaries
# land in the committed sessions tier.
context/transcripts/imported/
# core-memory-kit:gitignore:end

# Public-repo dogfood deviation (Task 52, D-108): this repo is PUBLIC, so the
# raw conversation surfaces stay machine-local — transcripts + session logs
# carry dev-conversation content (name-privacy class). The kit's default in a
# normal project is to COMMIT these; the curated tiers (MEMORY.md, SOUL.md,
# context/memory/) stay committed here as designed.
context/transcripts/
context/sessions/
packages/cli/context/

# Obsidian vault config (Task 254: users open context/memory/ — or the whole
# repo — as a vault; Obsidian writes per-user workspace state into .obsidian/
# wherever it opens. Never committed, at any depth — found live on the task's
# first real use, D-399).
.obsidian/

# Logo design scratch files (the shippable assets live in docs/public/assets/)
docs/public/*.html
docs/public/A _ Restore.png
*.stackdump
