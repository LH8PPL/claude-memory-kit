{
  "name": "@core-memory-kit/repo",
  "version": "0.0.1",
  "private": true,
  "description": "Per-project, in-repo memory system for Claude Code. Monorepo root for development; published packages live under packages/.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/validate-test-ids.mjs && node scripts/validate-template.mjs && node scripts/validate-exit-doors.mjs && node scripts/validate-docs.mjs && node scripts/validate-spawn-discipline.mjs && node scripts/validate-numbering-gaps.mjs && node scripts/validate-composition.mjs && node scripts/validate-budget-pairs.mjs && node scripts/validate-prompt-assertions.mjs && node scripts/validate-skill-allowlist.mjs && node scripts/validate-platform-commands.mjs && node scripts/validate-skill-sources.mjs && node scripts/validate-cli-mcp-parity.mjs && node scripts/validate-node-parse.mjs && node scripts/validate-pack-completeness.mjs && node scripts/validate-maintainer-name-confined.mjs && node scripts/validate-agent-adapter-parity.mjs && node scripts/validate-backlog-triggers.mjs && node scripts/validate-node-pin.mjs && node scripts/validate-install-consent.mjs",
    "test": "npm run lint && vitest run",
    "test:file": "node scripts/test-file.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "stress": "node scripts/stress-test.mjs",
    "live-verify": "node scripts/live-verify.mjs",
    "live-verify:now-roll": "node scripts/live-verify-now-roll.mjs",
    "live-verify:health-whisper": "node scripts/live-verify-health-whisper.mjs",
    "live-test": "node scripts/live-test.mjs",
    "live-test:backend": "node scripts/live-test-backend.mjs",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/print-release-notes.mjs",
    "lint:test-ids": "node scripts/validate-test-ids.mjs",
    "lint:exit-doors": "node scripts/validate-exit-doors.mjs",
    "lint:docs": "node scripts/validate-docs.mjs",
    "lint:references": "node scripts/validate-docs.mjs --only references",
    "lint:spawn-discipline": "node scripts/validate-spawn-discipline.mjs",
    "lint:numbering-gaps": "node scripts/validate-numbering-gaps.mjs",
    "lint:composition": "node scripts/validate-composition.mjs",
    "lint:budget-pairs": "node scripts/validate-budget-pairs.mjs",
    "lint:prompt-assertions": "node scripts/validate-prompt-assertions.mjs",
    "lint:skill-allowlist": "node scripts/validate-skill-allowlist.mjs",
    "trend:extract": "node scripts/extract-trend.mjs",
    "lint:platform-commands": "node scripts/validate-platform-commands.mjs",
    "lint:doc-registry": "node scripts/validate-docs.mjs --only registry",
    "lint:skill-sources": "node scripts/validate-skill-sources.mjs",
    "lint:cli-mcp-parity": "node scripts/validate-cli-mcp-parity.mjs",
    "lint:maintainer-name": "node scripts/validate-maintainer-name-confined.mjs",
    "lint:pack-completeness": "node scripts/validate-pack-completeness.mjs",
    "lint:index-completeness": "node scripts/validate-docs.mjs --only catalogs",
    "lint:adapter-parity": "node scripts/validate-agent-adapter-parity.mjs",
    "lint:backlog-triggers": "node scripts/validate-backlog-triggers.mjs",
    "sync:plugin-skills": "node scripts/sync-plugin-skills.mjs",
    "validate:template": "node scripts/validate-template.mjs",
    "bench:recall": "node scripts/bench-recall.mjs",
    "bench:linking": "node scripts/bench-linking.mjs",
    "live-verify:viewer": "node scripts/live-verify-viewer.mjs",
    "live-verify:semantic": "node scripts/live-verify-semantic.mjs",
    "lint:install-consent": "node scripts/validate-install-consent.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LH8PPL/core-memory-kit.git"
  }
}
